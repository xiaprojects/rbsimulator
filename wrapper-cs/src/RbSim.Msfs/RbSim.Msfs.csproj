<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- rbsim-msfs: MSFS SimConnect source with the HTTP/WebSocket status server. Windows x64 only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>rbsim-msfs</AssemblyName>
    <RootNamespace>RbSim.Msfs</RootNamespace>
    <Version>0.1.0</Version>
    <!-- SimConnect.dll is native x64; never AnyCPU. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="RbSim.Msfs.wwwroot.index.html" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RbSim.Core\RbSim.Core.csproj" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Beside the exe, never bundled into the single file, so users can copy and edit it. -->
    <None Include="..\..\rbsim-msfs.example.json" Link="rbsim-msfs.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
